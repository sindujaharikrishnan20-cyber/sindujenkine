pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                echo "Code from GitHub"
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t myapp .'
            }
        }

        stage('Docker Image') {
            steps {
                sh 'docker images'
            }
        }
    }

    post {
        success {
            echo "Docker build successful"
        }

        failure {
            echo "Docker build failed"
        }
    }
}
